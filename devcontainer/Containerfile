FROM docker.io/library/node:26.12.0-bookworm@sha256:bfb78a64f53d36c691f27dceecc9d4e73b3526411e1cee6fdf8d981d06fb2eb7

LABEL "org.opencontainers.image.description"="Kitten Scientists Development Container"

ARG REPO=https://github.com/nuclear-unicorn/kittensgame.git
ARG BRANCH=master
ARG COMMIT=master

EXPOSE 8080
EXPOSE 8086

RUN git config --global http.version HTTP/1.1 \
  && git clone --branch "$BRANCH" --single-branch "$REPO" \
  && cd kittensgame \
  && git checkout "$COMMIT" \
  && npm add --save-dev @oliversalzburg/js-utils cheerio watch-http-server

WORKDIR /kittensgame
COPY "devcontainer/overlay/*" "./overlay/"
COPY "output/entrypoint-devcontainer.mjs" "./mod/"
RUN [ "chmod", "+x", "mod/entrypoint-devcontainer.mjs" ]

CMD [ "/bin/bash", "-c", "mod/entrypoint-devcontainer.mjs" ]
