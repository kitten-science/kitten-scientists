{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,
		"isolatedModules": true,
		"lib": [
			"ESNext"
		],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"outDir": "output",
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"target": "esnext",
		"types": [
			"dojo",
			"node",
			"web"
		],
		"useDefineForClassFields": true
	},
	"exclude": [
		"./devcontainer/overlay"
	],
	"include": [
		"./@types",
		"./devcontainer",
		"./source",
		"./source/i18n/**/*.json",
		"./vite.config.*.js"
	]
}
